{
  "name": "claude-code-acp-delegate",
  "version": "0.1.0",
  "description": "Claude Code plugin that delegates self-contained tasks to ACP-compatible coding agents via MCP.",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "esbuild src/acp-server.ts --bundle --platform=node --format=cjs --outfile=dist/acp-server.js",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@regaltsui/acp-delegate": "github:regaltsui/acp-delegate-core"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "acp",
    "agent-client-protocol",
    "agent",
    "delegation"
  ],
  "repository": "https://github.com/regaltsui/claude-code-acp-delegate",
  "homepage": "https://github.com/regaltsui/claude-code-acp-delegate",
  "author": {
    "name": "regaltsui"
  }
}
